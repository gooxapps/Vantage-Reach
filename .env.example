# DATABASE_URL / POSTGRES_URL: Neon PostgreSQL connection string (automatically injected by Vercel Neon Integration).
# Leave empty in local development to use the built-in local SQLite database.
DATABASE_URL=""
POSTGRES_URL=""

# GEMINI_API_KEY: Required for Gemini AI SEO analysis calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: YouTube Data API v3 key for live video stats and competitor search.
# Can also be configured securely from the Vantage Reach Admin Console.
YOUTUBE_API_KEY=""

# PAYSTACK_SECRET_KEY & FLUTTERWAVE_SECRET_KEY: Optional merchant secret keys for live payment verification.
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# SESSION_SECRET: Secret key used to sign HTTP-only authentication session cookies.
# Required in production (Vercel) so sessions stay valid across serverless invocations.
SESSION_SECRET="replace-with-strong-random-secret"

# APP_URL: The URL where this applet is hosted (e.g. https://your-app.vercel.app).
APP_URL="MY_APP_URL"
